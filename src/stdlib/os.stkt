// ==========================================
// Stkt Standard Library: OS (os.stkt)
// ==========================================
//

export fn arg_count: i32(){
    return stkt_args_count()
}

export fn get_args: [str](){
    return stkt_get_args()
}

export fn get_env: str(key: str){
    return stkt_get_env(key)

}

export fn system_cmd: i32(cmd: str) {
    return stkt_system(cmd)
}
