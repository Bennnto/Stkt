// ======================================================
// Stkt Standard Library: File & IO (io.stkt)
// ======================================================

// Check if a file exists on disk
export fn file_exists :bool(path: str) {
    return stkt_file_exists(path)
}

// Write text content to a file (creates or overwrites)
// Returns true on success, false on failure
export fn write_text :bool(path: str, content: str) {
    return stkt_file_write(path, content)
}

// Read the entire contents of a file into a string
// Returns the string content, or "" if the file cannot be read
export fn read_text :str(path: str) {
    return stkt_file_read(path)
}

export fn append_text :bool(path: str, content: str) {
    return stkt_file_append(path, content)
}

export fn file_size :i32(path: str) {
    if file_exists(path) {
        return stkt_file_size(path)
    } else {
        return -1
    }
}
