// ======================================================
// Stkt Standard Library: Collections (collections.stkt)
// ======================================================

export fn sum_i32 :i32(arr: [i32]) {
    let i: i32 = 0
    let total: i32 = 0
    while i < len(arr) {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

export fn contain_i32 :bool(arr: [i32], val: i32) {
    let i: i32 = 0
    while i < len(arr) {
        if arr[i] == val {
            return true
        }
        i = i + 1
    }
    return false
}

export fn max_elem :i32(arr: [i32]) {
    let highest: i32 = arr[0]
    let i: i32 = 1
    while i < len(arr) {
        if arr[i] > highest {
            highest = arr[i]
        }
        i = i + 1
    }
    return highest
}

export fn min_elem :i32(arr: [i32]) {
    let lowest: i32 = arr[0]
    let i: i32 = 1
    while i < len(arr) {
        if arr[i] < lowest {
            lowest = arr[i]
        }
        i = i + 1
    }
    return lowest
}

export fn count_elem :i32(arr: [i32], val: i32) {
    let i: i32 = 0
    let count: i32 = 0
    while i < len(arr) {
        if arr[i] == val {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

export fn index_of :i32(arr: [i32], val: i32) {
    let i: i32 = 0
    while i < len(arr) {
        if arr[i] == val {
            return i
        }
        i = i + 1
    }
    return -1
}
