// ==========================================
// Stkt Standard Library: Math (math.stkt)
// ==========================================

// ------------------------------------------
// 1. Basic Arithmetic, Bounds & Properties
// ------------------------------------------

export fn abs :i32(n: i32) {
    if n < 0 {
        return -n
    } else {
        return n
    }
}

export fn sign :i32(n: i32) {
    if n > 0 {
        return 1
    } else {
        if n < 0 {
            return -1
        } else {
            return 0
        }
    }
}

export fn max :i32(a: i32, b: i32) {
    if a > b {
        return a
    } else {
        return b
    }
}

export fn min :i32(a: i32, b: i32) {
    if a < b {
        return a
    } else {
        return b
    }
}

export fn clamp :i32(v: i32, low: i32, high: i32) {
    if v < low {
        return low
    } else {
        if v > high {
            return high
        } else {
            return v
        }
    }
}

export fn in_range :bool(v: i32, low: i32, high: i32) {
    return v >= low && v <= high
}

export fn is_even :bool(n: i32) {
    return n % 2 == 0
}

export fn is_odd :bool(n: i32) {
    return n % 2 != 0
}

// ------------------------------------------
// 2. Powers, Roots & Exponents
// ------------------------------------------

export fn pow_int :i32(base: i32, exp: i32) {
    if exp < 0 {
        return 0
    }
    let res: i32 = 1
    loop exp {
        res = res * base
    }
    return res
}

export fn sqrt_int :i32(n: i32) {
    if n <= 0 {
        return 0
    }
    if n == 1 {
        return 1
    }
    let x: i32 = n / 2
    let next_x: i32 = (x + n / x) / 2
    while next_x < x {
        x = next_x
        next_x = (x + n / x) / 2
    }
    return x
}

export fn cbrt_int :i32(n: i32) {
    if n <= 0 {
        return 0
    }
    if n == 1 {
        return 1
    }
    let x: i32 = n / 3
    let next_x: i32 = (2 * x + n / (x * x)) / 3
    while next_x < x {
        x = next_x
        next_x = (2 * x + n / (x * x)) / 3
    }
    return x
}

export fn hypot_int :i32(a: i32, b: i32) {
    return sqrt_int((a * a) + (b * b))
}

// ------------------------------------------
// 3. Number Theory & Divisibility
// ------------------------------------------

export fn gcd :i32(a: i32, b: i32) {
    let x: i32 = abs(a)
    let y: i32 = abs(b)
    while y != 0 {
        let t: i32 = y
        y = x % y
        x = t
    }
    return x
}

export fn lcm :i32(a: i32, b: i32) {
    if a == 0 || b == 0 {
        return 0
    }
    return abs(a * b) / gcd(a, b)
}

export fn is_prime :bool(n: i32) {
    if n <= 1 {
        return false
    }
    if n <= 3 {
        return true
    }
    if n % 2 == 0 || n % 3 == 0 {
        return false
    }
    let i: i32 = 5
    while i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 {
            return false
        }
        i = i + 6
    }
    return true
}

export fn next_prime :i32(n: i32) {
    if n <= 1 {
        return 2
    }
    let prime: i32 = n
    while true {
        prime = prime + 1
        if is_prime(prime) {
            return prime
        }
    }
}

export fn factorial :i32(n: i32) {
    if n < 0 {
        return 0
    }
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

export fn permutations :i32(n: i32, k: i32) {
    if k < 0 || k > n {
        return 0
    }
    return factorial(n) / factorial(n - k)
}

export fn combinations :i32(n: i32, k: i32) {
    if k < 0 || k > n {
        return 0
    }
    return factorial(n) / (factorial(k) * factorial(n - k))
}

// ------------------------------------------
// 4. Bitwise Operations & Binary Manipulations
// ------------------------------------------

export fn is_power_of_two :bool(n: i32) {
    if n <= 0 {
        return false
    }
    return (n & (n - 1)) == 0
}

export fn next_power_of_two :i32(n: i32) {
    if n <= 0 {
        return 1
    }
    let p: i32 = 1
    while p < n {
        p = p << 1
    }
    return p
}

export fn count_ones :i32(n: i32) {
    let count: i32 = 0
    let x: i32 = n
    while x != 0 {
        x = x & (x - 1)
        count = count + 1
    }
    return count
}

export fn count_zeros :i32(n: i32) {
    return 32 - count_ones(n)
}

export fn rotate_left :i32(n: i32, shift: i32) {
    let s: i32 = shift % 32
    if s < 0 {
        s = s + 32
    }
    if s == 0 {
        return n
    }
    return (n << s) | (n >> (32 - s))
}

export fn rotate_right :i32(n: i32, shift: i32) {
    let s: i32 = shift % 32
    if s < 0 {
        s = s + 32
    }
    if s == 0 {
        return n
    }
    return (n >> s) | (n << (32 - s))
}
