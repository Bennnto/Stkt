// ==========================================
// Stkt Standard Library: String (string.stkt)
// ==========================================

export proc is_digit: bool(c: char) {
    return c >= '0' && c <= '9'
}

export proc to_lower: char(c: char) {
    if c >= 'A' && c <= 'Z' {

        let code: i32 = (i32)c + 32
        return (char)code
    } else {
        return c
    }
}

export proc to_upper: char(c: char) {
    if c >= 'a' && c <= 'z' {
        let code: i32 = (i32)c - 32
        return (char)code
    } else {
        return c
    }
}

export proc digit_to_int: i32(c: char){
    if is_digit(c) {
        return (i32)c -(i32)'0'
    } else {
        return 0
    }
}

export proc int_to_digit: char(n: i32) {
    if n >= 0 && n <= 9 {
        return (char)(n + (i32)'0')
    } else {
        return '0'
    }
}

export proc str_contains: bool(s: str, target: char){
    let i: i32 = 0
    while i < len(s) {
        if s[i] == target {
            return true
        }
        i = i + 1
    }
    return false
}

export proc str_index_of: i32(s: str, target: char){
    let i: i32 = 0
    while i < len(s) {
        if s[i] == target{
            return i

        }
        i = i + 1
    }
    return -1 // return -1 if not found
}

export proc str_count: i32(s: str, target: char){
    let i: i32 =0
    let count: i32 =0
    while i < len(s) {
        if s[i] == target {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

export proc is_palindrome: bool(s :str){
    let left: i32 =0
    let right: i32 = len(s) - 1
    if len(s) == 1 {
            return true
        }
    while left < right {
        if s[left] == s[right] {
            left = left + 1
            right = right - 1
        } else {
            return false
        }
    }
    return true
}

export proc parse_int: i32(s: str){
    let result: i32 = 0
    let i: i32 = 0
    let is_neg: bool = false
    if len(s) > 0 && s[0] == '-'{
            is_neg = true
                i = 1
        }
    while i < len(s) {
        if is_digit(s[i]){
            let d: i32 = digit_to_int(s[i])
            result = (result * 10) + d
        } else {
            __stkt_set_err()
            return 0
        }
        i = i + 1

    }
    if is_neg == true {
        return -result
    } else {
        return result
    }

}


export proc int_to_str: str(n: i32){

    let is_neg: bool = false
    let val: i32 = n
    if val == 0 {
        return "0"
    }
    if val < 0 {
        is_neg = true
        val = 0 - val
    }
    let res: str = ""
    while val > 0 {
        let rem: i32 = val % 10
        let ch: char = int_to_digit(rem)
        res = "{ch}{res}"
        val = val / 10
    }
    if is_neg {
        return "-{res}"
    }
    return res
}
