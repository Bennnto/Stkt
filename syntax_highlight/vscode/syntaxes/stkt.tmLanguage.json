{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Stkt",
  "scopeName": "source.stkt",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.stkt",
          "match": "//.*$"
        },
        {
          "name": "comment.block.stkt",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.stkt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.stkt",
              "match": "\\\\([nrtvfb0\\\\\"']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            },
            {
              "name": "meta.interpolation.stkt",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.embedded.begin.stkt" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.embedded.end.stkt" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.stkt",
          "match": "'(\\\\([nrtvfb0\\\\\"']|x[0-9a-fA-F]{2})|[^\\\\'])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.stkt",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.stkt",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.stkt",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.integer.stkt",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.declaration.stkt",
          "match": "\\b(let|const|type)\\b"
        },
        {
          "name": "keyword.control.module.stkt",
          "match": "\\b(sync|export|as)\\b"
        },
        {
          "name": "keyword.control.flow.stkt",
          "match": "\\b(if|else|while|loop|step|for|match|case|default|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.function.stkt",
          "match": "\\b(proc|procedure|L)\\b"
        },
        {
          "name": "constant.language.boolean.stkt",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.stkt",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|int|float|bool|char|str|void)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.stkt",
          "match": "\\b(onscreen|onkey|scan|append|len|pop)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(proc|procedure)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.function.stkt" },
            "2": { "name": "entity.name.function.stkt" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.stkt" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.stkt",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.stkt",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.stkt",
          "match": "&|\\||\\^|~|<<|>>"
        },
        {
          "name": "keyword.operator.arithmetic.stkt",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.stkt",
          "match": "="
        },
        {
          "name": "keyword.operator.pipe.stkt",
          "match": "\\|>"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.stkt",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.section.bracket.stkt",
          "match": "[\\[\\]\\{\\}\\(\\)]"
        }
      ]
    }
  }
}
