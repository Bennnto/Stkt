// ==========================================
// Stkt Self-Hosted Compiler: Runtime (runtime.stkt)
// Modular C runtime definitions mirroring src/runtime.py
// ==========================================

export fn get_runtime_headers: str() {
    let out: str = ""
    out = out + "#include <stdio.h>\n"
    out = out + "#include <stdlib.h>\n"
    out = out + "#include <stdint.h>\n"
    out = out + "#include <stdbool.h>\n"
    out = out + "#include <string.h>\n"
    out = out + "#include <math.h>\n"
    out = out + "#include <stdarg.h>\n"
    out = out + "#include <ctype.h>\n"
    out = out + "#include <sys/time.h>\n"
    out = out + "#include <unistd.h>\n"
    return out
}

export fn get_runtime_core: str() {
    let out: str = ""
    out = out + "static int __attribute__((unused)) __stkt_argc = 0;\n"
    out = out + "static char** __attribute__((unused)) __stkt_argv = NULL;\n"
    out = out + "static inline __attribute__((unused)) void stkt_exit(int32_t code) { exit(code); }\n"
    out = out + "static inline __attribute__((unused)) int32_t stkt_scan_i32() { int32_t v=0; if (scanf(\"%d\", &v) != 1) return 0; return v; }\n"
    out = out + "static inline __attribute__((unused)) double stkt_scan_f64() { double v=0; if (scanf(\"%lf\", &v) != 1) return 0; return v; }\n"
    out = out + "static inline __attribute__((unused)) char* stkt_scan_str() { char* b = (char*)malloc(1024); if (!b) return \"\"; if (!fgets(b, 1024, stdin)) { b[0] = 0; return b; } size_t l = strlen(b); if (l > 0 && b[l-1] == '\\n') b[l-1] = 0; if (l > 1 && b[l-2] == '\\r') b[l-2] = 0; return b; }\n"
    out = out + "static inline __attribute__((unused)) bool stkt_scan_bool() { char b[16]; if (scanf(\"%15s\", b) != 1) return false; return (strcmp(b, \"true\") == 0 || strcmp(b, \"1\") == 0); }\n"
    out = out + "static inline __attribute__((unused)) char stkt_scan_char() { char c = 0; if (scanf(\" %c\", &c) != 1) return 0; return c; }\n"
    out = out + "typedef struct __stkt_arena_chunk { char* memory; size_t capacity; size_t offset; struct __stkt_arena_chunk* next; } __stkt_arena_chunk;\n"
    out = out + "typedef struct { __stkt_arena_chunk* current; size_t default_chunk_size; } __stkt_arena;\n"
    out = out + "static inline __attribute__((unused)) int64_t stkt_arena_create(int32_t chunk_size) { if (chunk_size <= 0) chunk_size = 65536; __stkt_arena* a = (__stkt_arena*)malloc(sizeof(__stkt_arena)); a->default_chunk_size = (size_t)chunk_size; __stkt_arena_chunk* c = (__stkt_arena_chunk*)malloc(sizeof(__stkt_arena_chunk)); c->memory = (char*)malloc((size_t)chunk_size); c->capacity = (size_t)chunk_size; c->offset = 0; c->next = NULL; a->current = c; return (int64_t)(uintptr_t)a; }\n"
    out = out + "static inline __attribute__((unused)) void* stkt_arena_alloc(__stkt_arena* a, size_t size) { if (!a) return NULL; size = (size + 7) & ~7; __stkt_arena_chunk* c = a->current; if (c->offset + size > c->capacity) { size_t new_cap = a->default_chunk_size; if (size > new_cap) new_cap = size; __stkt_arena_chunk* nc = (__stkt_arena_chunk*)malloc(sizeof(__stkt_arena_chunk)); nc->memory = (char*)malloc(new_cap); nc->capacity = new_cap; nc->offset = 0; nc->next = c; a->current = nc; c = nc; } void* ptr = (void*)(c->memory + c->offset); c->offset += size; return ptr; }\n"
    out = out + "static inline __attribute__((unused)) char* stkt_arena_alloc_str(int64_t handle, const char* s) { __stkt_arena* a = (__stkt_arena*)(uintptr_t)handle; if (!a || !s) return \"\"; size_t len = strlen(s); char* dest = (char*)stkt_arena_alloc(a, len + 1); if (!dest) return \"\"; memcpy(dest, s, len); dest[len] = 0; return dest; }\n"
    out = out + "static inline __attribute__((unused)) void stkt_arena_reset(int64_t handle) { __stkt_arena* a = (__stkt_arena*)(uintptr_t)handle; if (!a) return; __stkt_arena_chunk* c = a->current; while (c) { c->offset = 0; c = c->next; } }\n"
    out = out + "static inline __attribute__((unused)) void stkt_arena_destroy(int64_t handle) { __stkt_arena* a = (__stkt_arena*)(uintptr_t)handle; if (!a) return; __stkt_arena_chunk* c = a->current; while (c) { __stkt_arena_chunk* next = c->next; if (c->memory) free(c->memory); free(c); c = next; } free(a); }\n"
    out = out + "static inline __attribute__((unused)) char* stkt_format(const char* fmt, ...) { va_list args, args2; va_start(args, fmt); va_copy(args2, args); int len = vsnprintf(NULL, 0, fmt, args); va_end(args); if (len < 0) { va_end(args2); return \"\"; } char* b = (char*)malloc((size_t)len + 1); if (!b) { va_end(args2); return \"\"; } vsnprintf(b, (size_t)len + 1, fmt, args2); va_end(args2); return b; }\n"
    return out
}

export fn get_runtime_slices: str() {
    let out: str = ""
    out = out + "#define STKT_SLICE_DEFINE(TYPE, NAME) typedef struct { TYPE* data; size_t len; size_t cap; } __stkt_slice_buf_##NAME; typedef struct { __stkt_slice_buf_##NAME* buf; } NAME;\n"
    out = out + "STKT_SLICE_DEFINE(int32_t, stkt_slice_i32)\n"
    out = out + "STKT_SLICE_DEFINE(int64_t, stkt_slice_i64)\n"
    out = out + "STKT_SLICE_DEFINE(float, stkt_slice_f32)\n"
    out = out + "STKT_SLICE_DEFINE(double, stkt_slice_f64)\n"
    out = out + "STKT_SLICE_DEFINE(char*, stkt_slice_str)\n"
    out = out + "#define STKT_SLICE_INIT(s) do { (s).buf = malloc(sizeof(*((s).buf))); (s).buf->data = NULL; (s).buf->len = 0; (s).buf->cap = 0; } while(0)\n"
    out = out + "#define STKT_SLICE_APPEND(s, val) do { if ((s).buf->len >= (s).buf->cap) { (s).buf->cap = ((s).buf->cap == 0) ? 4 : ((s).buf->cap * 2); (s).buf->data = realloc((s).buf->data, (s).buf->cap * sizeof(*((s).buf->data))); } (s).buf->data[(s).buf->len++] = (val); } while(0)\n"
    out = out + "#define STKT_SLICE_POP(s) ((s).buf->data[--((s).buf->len)])\n"
    out = out + "#define STKT_SLICE_LEN(s) ((int32_t)((s).buf->len))\n"
    return out
}

export fn get_runtime_error: str() {
    let out: str = ""
    out = out + "static bool __attribute__((unused)) __stkt_has_error = false;\n"
    out = out + "static inline __attribute__((unused)) void __stkt_set_err() { __stkt_has_error = true; }\n"
    out = out + "static inline __attribute__((unused)) void __stkt_clear_err() { __stkt_has_error = false; }\n"
    return out
}

export fn get_runtime_strings: str() {
    let out: str = ""
    out = out + "static inline __attribute__((unused)) char* stkt_str_concat(const char* s1, const char* s2) { if (!s1) s1 = \"\"; if (!s2) s2 = \"\"; size_t l1 = strlen(s1); size_t l2 = strlen(s2); char* r = (char*)malloc(l1 + l2 + 1); if (!r) return \"\"; memcpy(r, s1, l1); memcpy(r + l1, s2, l2); r[l1 + l2] = 0; return r; }\n"
    out = out + "static inline __attribute__((unused)) char* stkt_str_slice(const char* s, int32_t start, int32_t end) { if (!s) return \"\"; int32_t l = (int32_t)strlen(s); if (start < 0) start = 0; if (end > l) end = l; if (start >= end) { char* e = (char*)malloc(1); e[0] = 0; return e; } int32_t sub_len = end - start; char* r = (char*)malloc(sub_len + 1); if (!r) return \"\"; memcpy(r, s + start, sub_len); r[sub_len] = 0; return r; }\n"
    out = out + "static inline __attribute__((unused)) stkt_slice_str stkt_str_split(const char* s, const char* sep) { stkt_slice_str res; STKT_SLICE_INIT(res); if (!s || !sep) return res; size_t sl = strlen(sep); if (sl == 0) { STKT_SLICE_APPEND(res, strdup(s)); return res; } const char* curr = s; const char* found; while ((found = strstr(curr, sep)) != NULL) { size_t pl = found - curr; char* p = (char*)malloc(pl + 1); memcpy(p, curr, pl); p[pl] = 0; STKT_SLICE_APPEND(res, p); curr = found + sl; } STKT_SLICE_APPEND(res, strdup(curr)); return res; }\n"
    out = out + "static inline __attribute__((unused)) char* stkt_str_trim(const char* s) { if (!s) return \"\"; while (isspace((unsigned char)*s)) s++; if (*s == 0) return strdup(\"\"); const char* end = s + strlen(s) - 1; while (end > s && isspace((unsigned char)*end)) end--; size_t l = end - s + 1; char* r = (char*)malloc(l + 1); memcpy(r, s, l); r[l] = 0; return r; }\n"
    out = out + "static inline __attribute__((unused)) bool stkt_str_contains(const char* s, const char* sub) { if (!s || !sub) return false; return strstr(s, sub) != NULL; }\n"
    return out
}

export fn get_runtime_io: str() {
    let out: str = ""
    out = out + "static inline __attribute__((unused)) bool stkt_file_exists(const char* path) { if (!path) return false; FILE* f = fopen(path, \"r\"); if (f) { fclose(f); return true; } return false; }\n"
    out = out + "static inline __attribute__((unused)) bool stkt_file_write(const char* path, const char* content) { if (!path) return false; FILE* f = fopen(path, \"w\"); if (!f) return false; fputs(content ? content : \"\", f); fclose(f); return true; }\n"
    out = out + "static inline __attribute__((unused)) bool stkt_file_append(const char* path, const char* content) { if (!path) return false; FILE* f = fopen(path, \"a\"); if (!f) return false; fputs(content ? content : \"\", f); fclose(f); return true; }\n"
    out = out + "static inline __attribute__((unused)) int32_t stkt_file_size(const char* path) { if (!path) return -1; FILE* f = fopen(path, \"rb\"); if (!f) return -1; fseek(f, 0, SEEK_END); long s = ftell(f); fclose(f); return (int32_t)s; }\n"
    out = out + "static inline __attribute__((unused)) char* stkt_file_read(const char* path) { if (!path) return \"\"; FILE* f = fopen(path, \"rb\"); if (!f) return \"\"; fseek(f, 0, SEEK_END); long s = ftell(f); fseek(f, 0, SEEK_SET); char* b = (char*)malloc(s + 1); if (!b) { fclose(f); return \"\"; } size_t r = fread(b, 1, s, f); b[r] = 0; fclose(f); return b; }\n"
    return out
}

export fn get_runtime_hmap: str() {
    let out: str = ""
    out = out + "typedef struct __stkt_map_entry_str_i32 { char* key; int32_t val; struct __stkt_map_entry_str_i32* next; } __stkt_map_entry_str_i32;\n"
    out = out + "typedef struct { __stkt_map_entry_str_i32* buckets[64]; int32_t size; } __stkt_map_str_i32;\n"
    out = out + "static inline __attribute__((unused)) uint32_t __stkt_hash_str(const char* s) { uint32_t h = 2166136261u; if (!s) return 0; while (*s) { h ^= (uint8_t)*s++; h *= 16777619u; } return h; }\n"
    out = out + "static inline __attribute__((unused)) __stkt_map_str_i32* __stkt_map_create_str_i32() { return (__stkt_map_str_i32*)calloc(1, sizeof(__stkt_map_str_i32)); }\n"
    out = out + "static inline __attribute__((unused)) void __stkt_map_set_str_i32(__stkt_map_str_i32* m, const char* key, int32_t val) { if (!m || !key) return; uint32_t idx = __stkt_hash_str(key) % 64; __stkt_map_entry_str_i32* curr = m->buckets[idx]; while (curr) { if (strcmp(curr->key, key) == 0) { curr->val = val; return; } curr = curr->next; } __stkt_map_entry_str_i32* entry = (__stkt_map_entry_str_i32*)malloc(sizeof(__stkt_map_entry_str_i32)); entry->key = strdup(key); entry->val = val; entry->next = m->buckets[idx]; m->buckets[idx] = entry; m->size++; }\n"
    out = out + "static inline __attribute__((unused)) int32_t __stkt_map_get_str_i32(__stkt_map_str_i32* m, const char* key) { if (!m || !key) { __stkt_set_err(); return 0; } uint32_t idx = __stkt_hash_str(key) % 64; __stkt_map_entry_str_i32* curr = m->buckets[idx]; while (curr) { if (strcmp(curr->key, key) == 0) { return curr->val; } curr = curr->next; } __stkt_set_err(); return 0; }\n"
    out = out + "static inline __attribute__((unused)) bool __stkt_map_has_str_i32(__stkt_map_str_i32* m, const char* key) { if (!m || !key) return false; uint32_t idx = __stkt_hash_str(key) % 64; __stkt_map_entry_str_i32* curr = m->buckets[idx]; while (curr) { if (strcmp(curr->key, key) == 0) return true; curr = curr->next; } return false; }\n"
    out = out + "static inline __attribute__((unused)) stkt_slice_str __stkt_map_keys_str_i32(__stkt_map_str_i32* m) { stkt_slice_str res; STKT_SLICE_INIT(res); if (!m) return res; for (int i = 0; i < 64; i++) { __stkt_map_entry_str_i32* curr = m->buckets[i]; while (curr) { STKT_SLICE_APPEND(res, curr->key); curr = curr->next; } } return res; }\n"
    out = out + "typedef struct __stkt_map_entry_str_str { char* key; char* val; struct __stkt_map_entry_str_str* next; } __stkt_map_entry_str_str;\n"
    out = out + "typedef struct { __stkt_map_entry_str_str* buckets[64]; int32_t size; } __stkt_map_str_str;\n"
    out = out + "static inline __attribute__((unused)) __stkt_map_str_str* __stkt_map_create_str_str() { return (__stkt_map_str_str*)calloc(1, sizeof(__stkt_map_str_str)); }\n"
    out = out + "static inline __attribute__((unused)) void __stkt_map_set_str_str(__stkt_map_str_str* m, const char* key, const char* val) { if (!m || !key) return; uint32_t idx = __stkt_hash_str(key) % 64; __stkt_map_entry_str_str* curr = m->buckets[idx]; while (curr) { if (strcmp(curr->key, key) == 0) { if (curr->val) free(curr->val); curr->val = val ? strdup(val) : strdup(\"\"); return; } curr = curr->next; } __stkt_map_entry_str_str* entry = (__stkt_map_entry_str_str*)malloc(sizeof(__stkt_map_entry_str_str)); entry->key = strdup(key); entry->val = val ? strdup(val) : strdup(\"\"); entry->next = m->buckets[idx]; m->buckets[idx] = entry; m->size++; }\n"
    out = out + "static inline __attribute__((unused)) char* __stkt_map_get_str_str(__stkt_map_str_str* m, const char* key) { if (!m || !key) { __stkt_set_err(); return \"\"; } uint32_t idx = __stkt_hash_str(key) % 64; __stkt_map_entry_str_str* curr = m->buckets[idx]; while (curr) { if (strcmp(curr->key, key) == 0) { return curr->val; } curr = curr->next; } __stkt_set_err(); return \"\"; }\n"
    out = out + "static inline __attribute__((unused)) bool __stkt_map_has_str_str(__stkt_map_str_str* m, const char* key) { if (!m || !key) return false; uint32_t idx = __stkt_hash_str(key) % 64; __stkt_map_entry_str_str* curr = m->buckets[idx]; while (curr) { if (strcmp(curr->key, key) == 0) return true; curr = curr->next; } return false; }\n"
    out = out + "static inline __attribute__((unused)) stkt_slice_str __stkt_map_keys_str_str(__stkt_map_str_str* m) { stkt_slice_str res; STKT_SLICE_INIT(res); if (!m) return res; for (int i = 0; i < 64; i++) { __stkt_map_entry_str_str* curr = m->buckets[i]; while (curr) { STKT_SLICE_APPEND(res, curr->key); curr = curr->next; } } return res; }\n"
    return out
}

export fn get_runtime_os: str() {
    let out: str = ""
    out = out + "static inline __attribute__((unused)) int32_t stkt_args_count() { return (int32_t)__stkt_argc; }\n"
    out = out + "static inline __attribute__((unused)) stkt_slice_str stkt_get_args() { stkt_slice_str args; STKT_SLICE_INIT(args); for (int i = 0; i < __stkt_argc; i++) { STKT_SLICE_APPEND(args, __stkt_argv[i]); } return args; }\n"
    out = out + "static inline __attribute__((unused)) char* stkt_get_env(const char* key) { if (!key) return \"\"; char* v = getenv(key); return v ? v : (char*)\"\"; }\n"
    out = out + "static inline __attribute__((unused)) int32_t stkt_system(const char* cmd) { if (!cmd) return -1; return system(cmd); }\n"
    return out
}

export fn get_runtime_time: str() {
    let out: str = ""
    out = out + "static inline __attribute__((unused)) int64_t stkt_time_now_ms() { struct timeval tv; gettimeofday(&tv, NULL); return ((int64_t)tv.tv_sec * 1000) + (tv.tv_usec / 1000); }\n"
    out = out + "static inline __attribute__((unused)) int64_t stkt_time_now_us() { struct timeval tv; gettimeofday(&tv, NULL); return ((int64_t)tv.tv_sec * 1000000) + tv.tv_usec; }\n"
    out = out + "static inline __attribute__((unused)) void stkt_time_sleep_ms(int32_t ms) { if (ms > 0) usleep((useconds_t)ms * 1000); }\n"
    return out
}

export fn get_full_runtime: str() {
    let r1: str = get_runtime_core()
    let r2: str = get_runtime_slices()
    let r3: str = get_runtime_error()
    let r4: str = get_runtime_strings()
    let r5: str = get_runtime_io()
    let r6: str = get_runtime_hmap()
    let r7: str = get_runtime_os()
    let r8: str = get_runtime_time()
    return "{r1}{r2}{r3}{r4}{r5}{r6}{r7}{r8}"
}
