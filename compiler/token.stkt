enum TokenKind {
    TokEof,
    TokInt,
    TokStr,
    TokIdent,
    TokAssign,
    TokPlus,
    TokMinus,
    TokStar,
    TokSlash,
    TokLParen,
    TokRParen,
    TokLBrace,
    TokRBrace,
    TokLBracket,
    TokRBracket,
    TokLet,
    TokProc,
    TokIf,
    TokElse,
    TokWhile,
    TokReturn,
    TokOnscreen,
    TokOnkey,
    TokColon,
    TokComma,
    TokSemicolon,
    TokEq,
    TokNe,
    TokLt,
    TokGt,
    TokLe,
    TokGe,
    TokAnd,
    TokOr,
    TokNot,
    TokBreak,
    TokContinue,
    TokConst,
    TokFor,
    TokLoop,
    TokStep,
    TokIn,
    TokMatch,
    TokCase,
    TokDefault,
    TokQuestion,
    TokLambda,
    TokTrue,
    TokFalse,
    TokFloat,
    TokChar,
    TokType,
    TokDot,
    TokEnum,
    TokPop,
    TokAppend,
    TokLen,
    TokHMap,
    TokIsok,
    TokSync,
    TokExport,
    TokAs,

}

type Token {
    kind: TokenKind,
    val: i32,
    fval: f32,
    text: str,
    next_pos: i32,
    line: i32
}
